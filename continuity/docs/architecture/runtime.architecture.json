  "cards": [
    {
      "dot": "cyan",
      "title": "Skills run the work",
      "items": [
        "checkpoint writes without committing; checklist runs the spine and writes via checkpoint.",
        "pickup reads the same handoffs in either tool, grouping sibling worktrees before other subjects.",
        "handoff-prompt, wip, improve-harness and slim-harness complete the seven-skill surface."
      ]
    },
    {
      "dot": "emerald",
      "title": "Spine and shared storage",
      "items": [
        "Spine: record, knowledge, lessons, persist, handoff. The first four are slots.",
        "The checklist engine checks and composes; it does not execute skills or write a handoff.",
        "Handoffs, ledger, compaction backups and checklist state live outside either tool's data area."
      ]
    },
    {
      "dot": "slate",
      "title": "Not shown",
      "items": [
        "Installer trust internals, transcript parsing and optional session-cycling consumers.",
        "The user's record implementation and profile-bound commands; the package provides no record.",
        "The next interactive session invokes pickup to follow the handoff back to the record."
      ]
    }
  ]
