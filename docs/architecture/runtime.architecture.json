  "cards": [
    {
      "dot": "rose",
      "title": "Approval and retry",
      "items": [
        "Capture proposes; only authorized rows execute. Changed scope or target confirmation stays pending.",
        "Confirmed receipts prevent repeated tasks or writing additions; uncertain effects require read-back."
      ]
    },
    {
      "dot": "emerald",
      "title": "Different retention",
      "items": [
        "Meeting record remains at its original path; original transcript follows policy-defined raw intake/archive rules.",
        "Research report moves from output to raw/derived only after terminal routes; it is excluded primary evidence.",
        "Compilation ingestion status is distinct from complete capture and absorption."
      ]
    },
    {
      "dot": "violet",
      "title": "Local policy and compatibility",
      "items": [
        "Profile v4 remains valid; templates, writing storage/workflows, compiler modes and audit coverage are local policy.",
        "research-absorb, research-to-wiki and vault-compile/vault-audit delegate; direct selected-source compile remains supported."
      ]
    },
    {
      "dot": "slate",
      "title": "Not shown",
      "items": [
        "Inline research-quick/research-dev and feature/feedback deliverables.",
        "Read-only opt-in wiki-audit, setup, installation/release and external provider internals.",
        "This map describes skill/helper contracts; local workflow adapters own live provider permissions and read-back."
      ]
    }
  ]
