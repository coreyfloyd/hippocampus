    {
      "dot": "rose",
      "title": "Gates",
      "items": [
        "Every root-writing skill validates the profile first; invalid means stop",
        "research-absorb mutates nothing until the user approves the plan",
        "Every row ends integrated, updated, filed, or discarded; then retain the report as an excluded reference"
      ]
    },
    {
      "dot": "emerald",
      "title": "Knowledge root",
      "items": [
        "raw/, output/, docs/ always; wiki/ only when enabled",
        "Compile appends docs/log.md and updates hot.md",
        "Only selected primary source text feeds the compiler; the retained report is excluded"
      ]
    },
    {
      "dot": "slate",
      "title": "Not shown",
      "items": [
        "Inline research-quick / research-dev (answer in chat only)",
        "research-feature / research-feedback (own deliverables, not absorbed)",
        "Meeting capture (README flow), knowledge-capture, wiki-audit, setup, install + release scripts"
