  "cards": [
    {
      "dot": "slate",
      "title": "Workflow contract, not deployment status",
      "items": [
        "Colors and shapes identify roles; no node denotes a running command or completed installation.",
        "Meeting records stay at their original path after processing. Research finalize and transcript file-source are distinct operations."
      ]
    },
    {
      "dot": "slate",
      "title": "Scope and omitted detail",
      "items": [
        "Repeated absorb/report nodes are detail views of the same command or object.",
        "Provider internals, inline research, wrappers, setup, audit, installation and releases are omitted; their behavior is unchanged.",
        "Source identities, coverage, prior authority, current-context confirmations, authored prose, task dates and confirmed receipts remain authoritative."
      ]
    }
  ]
